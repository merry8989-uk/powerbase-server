# Anything here must never end up inside the image.
#
# `.env` and `.admin-password` are generated by setup.sh *before* the build, and
# `COPY . .` would bake them into a layer — where they stay readable to anyone
# who can pull the image, even after you change them. The container gets them
# through compose's env_file at run time instead, which is the point.

.env
.env.*
!.env.example
.admin-password

# State that belongs on the volume, not in the image.
*.db
*.db-wal
*.db-shm
backups/
data/

# Build and dev leftovers.
.git
.gitignore
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.idea/
.vscode/
.DS_Store

# Local overrides.
docker-compose.override.yml
