{
  "name": "powerbase-telemetry",
  "version": "1.0.0",
  "description": "Powerbase telemetry SDK for browsers and Node. Batches events, logs and errors to a self-hosted Powerbase server.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^20.14.0"
  },
  "keywords": [
    "telemetry",
    "observability",
    "logging",
    "self-hosted",
    "powerbase"
  ]
}
