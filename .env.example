# Powerbase — environment configuration
# Copy to .env and adjust. Every value has a working default.

POWERBASE_DB=./powerbase.db
POWERBASE_HOST=0.0.0.0
POWERBASE_PORT=8080
POWERBASE_LOG_LEVEL=INFO

# Ingest throttling (token bucket, per API key)
POWERBASE_RATE_BURST=120
POWERBASE_RATE_PER_SECOND=40

# Reject batches larger than this
POWERBASE_MAX_BATCH_SIZE=1000

# Set to "1" to disable PII redaction (development only)
POWERBASE_DISABLE_REDACTION=0

# --- Dashboard (Phase 3) -----------------------------------------------------
# Leave POWERBASE_ADMIN_PASSWORD unset and the dashboard is disabled entirely;
# the ingestion API keeps working.
POWERBASE_ADMIN_PASSWORD=
# How long a dashboard session cookie stays valid, in seconds (default 12h).
POWERBASE_SESSION_TTL_SECONDS=43200

# --- Maintenance (Phase 4) ---------------------------------------------------
# The server runs rollups, retention pruning and backups nightly on its own
# thread. Set to 0 if you drive maintenance from cron via scripts/maintenance.py.
POWERBASE_MAINTENANCE_ENABLED=1
# UTC hour at which the nightly pass runs.
POWERBASE_ROLLUP_HOUR=1
# How often the scheduler wakes to check whether the pass is due, in seconds.
POWERBASE_MAINTENANCE_INTERVAL_SECONDS=300
POWERBASE_BACKUP_DIR=./backups
POWERBASE_BACKUP_KEEP=7
POWERBASE_VACUUM_AFTER_PRUNE=1

# --- Alerts (Phase 5) --------------------------------------------------------
POWERBASE_ALERTS_ENABLED=1
POWERBASE_ALERT_WINDOW_HOURS=24
POWERBASE_CRASH_FREE_WARNING=0.99
POWERBASE_CRASH_FREE_CRITICAL=0.95
POWERBASE_ERROR_RATE_WARNING=0.05
POWERBASE_ERROR_RATE_CRITICAL=0.15
# Minutes without any ingested record before an app is called silent.
POWERBASE_SILENT_MINUTES=1440
POWERBASE_ROLLUP_STALE_DAYS=2
# Below this many samples a rate is not trusted enough to alert on.
POWERBASE_MIN_SAMPLES_FOR_RATES=20
# Optional: POST the alert report as JSON when something fires.
POWERBASE_ALERT_WEBHOOK_URL=

# --- Logging (Phase 5) -------------------------------------------------------
POWERBASE_LOG_LEVEL=INFO
# One JSON object per line, for shipping logs somewhere.
POWERBASE_LOG_JSON=0
POWERBASE_ACCESS_LOG=1
# Seconds a successful API-key verification is remembered (0 disables the cache).
POWERBASE_AUTH_CACHE_SECONDS=300

# --- Export (Step 3) ---------------------------------------------------------
# Where result files are written. Put this on the same volume as the database.
POWERBASE_EXPORT_DIR=./exports
# Rows one export may carry before it is truncated. Truncation is always reported.
POWERBASE_EXPORT_MAX_ROWS=50000
# How long a signed download link stays good, in seconds (default 7 days).
POWERBASE_EXPORT_TTL_SECONDS=604800

# --- Alerting (Step 5) -------------------------------------------------------
# How long an open incident stays quiet before it reminds you again.
POWERBASE_ALERT_COOLDOWN_MINUTES=60
# Attempts before a notification is given up on and marked dead.
POWERBASE_ALERT_DELIVERY_ATTEMPTS=5
# Email channel. Unset host means the email channel fails with a clear reason.
POWERBASE_SMTP_HOST=
POWERBASE_SMTP_PORT=587
POWERBASE_SMTP_USER=
POWERBASE_SMTP_PASSWORD=
POWERBASE_SMTP_FROM=
POWERBASE_SMTP_NO_STARTTLS=0

# --- Team access (Step 5) ----------------------------------------------------
# Bootstrap the first owner with:  powerbase owner --email you@example.com
POWERBASE_USER_SESSION_TTL_SECONDS=43200
POWERBASE_INVITE_TTL_SECONDS=604800

# --- Housekeeping retention -------------------------------------------------
# How long alert deliveries that have been sent or given up on, and finished
# log-drain runs, are kept. Undelivered notifications are never pruned.
# 0 disables the housekeeping prune.
POWERBASE_OPERATIONAL_RETENTION_DAYS=30
